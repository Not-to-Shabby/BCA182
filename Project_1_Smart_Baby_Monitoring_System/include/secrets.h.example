/**
 * @file secrets.h.example
 * @brief Copy to secrets.h (git-ignored) and fill in. NEVER commit
 *        secrets.h -- the spec forbids credentials in the repository.
 *
 * The build falls back to placeholder values when secrets.h is absent
 * (__has_include guard in net_task.c / mqtt_task.c), so the project still
 * compiles for grading without credentials.
 */
#ifndef SECRETS_H_EXAMPLE
#define SECRETS_H_EXAMPLE

#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASS       "your-wifi-password"

/* Any MQTT v3.1.1 broker reachable on the LAN. For a quick public test:
 * host "test.mosquitto.org", port 1883 (no auth, plaintext -- fine for
 * bring-up, documented trade-off; LAN Mosquitto with auth is the P5 path). */
#define MQTT_BROKER_HOST "test.mosquitto.org"
#define MQTT_BROKER_PORT 1883u

#endif /* SECRETS_H_EXAMPLE */
